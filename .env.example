# Credentials for the optional cloud warehouse targets.
#
# The default DuckDB target and CI need none of this. Copy to `.env`
# (gitignored), fill in only the warehouse you're using, and load it into
# your shell before running dbt, the load script, or the cloud parity tests:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# platforms/dbt/profiles.yml, scripts/load_synthetic_to_warehouse.py, and
# tests/test_dbt_parity.py all read these same variables. Never commit real
# values.

# --- Snowflake (dbt build --target snowflake) -------------------------------
# Account identifier, e.g. myorg-myaccount (no .snowflakecomputing.com).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# A password or a programmatic access token. Leave empty to use key-pair
# auth via SNOWFLAKE_PRIVATE_KEY_PATH instead.
SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
# Must already exist; the load script creates the schemas inside it.
SNOWFLAKE_DATABASE=

# --- Databricks (dbt build --target databricks) ------------------------------
# Workspace hostname, e.g. dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=
# SQL warehouse HTTP path, e.g. /sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_HTTP_PATH=
# Personal access token.
DATABRICKS_TOKEN=
# Unity Catalog catalog to build in. Defaults to `workspace`.
# DATABRICKS_CATALOG=workspace

# --- Redshift (dbt build --target redshift) ----------------------------------
REDSHIFT_HOST=
# REDSHIFT_PORT=5439
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_DATABASE=
# Optional: bulk-load with COPY from S3 instead of batched INSERTs. Needs
# AWS credentials in your environment that can write to the bucket, and an
# IAM role attached to the cluster that can read it.
# REDSHIFT_S3_BUCKET=
# REDSHIFT_S3_PREFIX=bi-framework/synthetic
# REDSHIFT_IAM_ROLE=arn:aws:iam::<account-id>:role/<role-name>

# --- Shared -----------------------------------------------------------------
# Schema the raw synthetic tables are loaded into and dbt reads them from.
# Defaults: `main` on DuckDB, `raw` on the cloud targets.
# BI_FRAMEWORK_RAW_SCHEMA=raw
# Which warehouse the opt-in cross-warehouse parity tests check:
# snowflake | databricks | redshift. Unset = those tests skip.
# DBT_PARITY_TARGET=
