model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","fct_order_items","dim_customers","marketing_spend"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table fct_order_items
ref table dim_customers
ref table marketing_spend
