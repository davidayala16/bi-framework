/// Precomputed by dbt (platforms/dbt/models/metrics/metric_churn_rate_90d.sql) as the registry metric `churn_rate_90d`. The registry marks this metric as not filterable, so the table is deliberately left without relationships: no slicer can reach it, and Power BI shows the same number the resolver returns. Reading the dbt table instead of re-deriving the cohort logic in DAX keeps the definition in one tested place (tests/test_dbt_parity.py pins this table to the registry).
table metric_churn_rate_90d
	lineageTag: 7e737d4e-e628-5876-a36d-7caea4f6b175

	/// Share of customers whose most recent order is more than 90 days before the dataset's max order date, i.e. customers who have gone quiet for a full quarter. A snapshot definition, not a rolling one, and not filterable by dimension in this demo.
	measure '90-Day Churn Rate' =
			-- Read from the one-row dbt metric table, not re-derived: churn is a
			-- snapshot against the dataset's last order date, which must not move
			-- with the filter context.
			MAX(metric_churn_rate_90d[churn_rate_90d_pct])
		formatString: 0.0\%
		displayFolder: Retention
		lineageTag: fc95707a-fc20-589a-9234-7f627818a6ae

		annotation registry_id = churn_rate_90d

		annotation registry_owner = analytics-team

	column churn_rate_90d_pct
		dataType: double
		isHidden
		lineageTag: adaf88f0-3bbf-525b-bb18-350b744a0228
		summarizeBy: none
		sourceColumn: churn_rate_90d_pct

	partition metric_churn_rate_90d = m
		mode: import
		source =
				let
				    Source = Odbc.Query(
				        "Driver=DuckDB Driver;Database=" & WarehousePath & ";access_mode=read_only",
				        "select churn_rate_90d_pct from analytics.metric_churn_rate_90d"
				    ),
				    Typed = Table.TransformColumnTypes(Source, {{"churn_rate_90d_pct", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table
