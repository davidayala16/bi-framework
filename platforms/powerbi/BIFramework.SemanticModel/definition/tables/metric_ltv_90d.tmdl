/// Precomputed by dbt (platforms/dbt/models/metrics/metric_ltv_90d.sql) as the registry metric `ltv_90d`. The registry marks this metric as not filterable, so the table is deliberately left without relationships: no slicer can reach it, and Power BI shows the same number the resolver returns. Reading the dbt table instead of re-deriving the cohort logic in DAX keeps the definition in one tested place (tests/test_dbt_parity.py pins this table to the registry).
table metric_ltv_90d
	lineageTag: 44623bc0-9883-56b9-9760-b215754fc6a7

	/// Average net revenue generated per customer within 90 days of their first order. A simplified LTV proxy — no discounting, no margin adjustment — intentionally, to keep the definition auditable at a glance rather than modeling-accurate. A cohort metric — not filterable by dimension in this demo.
	measure '90-Day Customer Lifetime Value' =
			-- Read from the one-row dbt metric table, not re-derived: the 90-day
			-- window is anchored on each customer's first order, which a slicer
			-- on order rows would silently break.
			MAX(metric_ltv_90d[ltv_90d])
		formatString: \$#,0.00
		displayFolder: Revenue
		lineageTag: 63824420-f579-5f2b-b076-483e75e7f24a

		annotation registry_id = ltv_90d

		annotation registry_owner = analytics-team

	column ltv_90d
		dataType: double
		isHidden
		lineageTag: 243107a4-ff7e-53a2-acf6-0df2812ccc65
		summarizeBy: none
		sourceColumn: ltv_90d

	partition metric_ltv_90d = m
		mode: import
		source =
				let
				    Source = Odbc.Query(
				        "Driver=DuckDB Driver;Database=" & WarehousePath & ";access_mode=read_only",
				        "select ltv_90d from analytics.metric_ltv_90d"
				    ),
				    Typed = Table.TransformColumnTypes(Source, {{"ltv_90d", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table
